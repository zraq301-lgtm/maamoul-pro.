model Purchase {
  id              String         @id @default(uuid())
  tenant_id       String
  idempotency_key String
  total_amount    Decimal        @db.Decimal(10, 2)
  status          String
  created_at      DateTime       @default(now())
  items           PurchaseItem[]

  @@unique([tenant_id, idempotency_key])
  @@index([tenant_id])
  @@map("purchase")
  @@schema("public") // أضف هذا السطر ليوجه Prisma للبحث في الـ public schema
}

model PurchaseItem {
  id          String   @id @default(uuid())
  purchase_id String
  purchase    Purchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  product_id  String
  quantity    Int
  unit_price  Decimal  @db.Decimal(10, 2)

  @@index([purchase_id])
  @@map("purchase_item")
  @@schema("public") // وأضف هذا السطر هنا أيضاً
}
