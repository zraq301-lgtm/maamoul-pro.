// 1. تعريف المولد
generator client {
  provider = "prisma-client-js"
}

// 2. تعريف مصدر البيانات (ضبط للاتصال بقاعدة بيانات Nile)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 3. النماذج (الجداول)
// تم تصميمها لتتوافق مع معيار Nile الخاص بـ Multi-tenancy
model Purchase {
  id              String         @id @default(uuid())
  tenant_id       String         // حقل إلزامي لتقسيم البيانات في Nile
  idempotency_key String         @unique
  total_amount    Decimal
  status          String
  created_at      DateTime       @default(now())
  items           PurchaseItem[]

  @@index([tenant_id]) // فهرس لتحسين سرعة الاستعلامات لكل مستأجر
}

model PurchaseItem {
  id          String   @id @default(uuid())
  purchase_id String
  purchase    Purchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  product_id  String
  quantity    Int
  unit_price  Decimal

  @@index([purchase_id]) // فهرس لتسريع العلاقة بين الفاتورة ومحتوياتها
}
