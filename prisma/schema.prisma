generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Purchase {
  id              String         @id @default(uuid())
  tenant_id       String
  idempotency_key String         @unique
  total_amount    Decimal        @db.Decimal(10, 2)
  status          String
  created_at      DateTime       @default(now())
  items           PurchaseItem[]

  @@index([tenant_id])
  @@map("purchase") // هذا يربط الموديل بالجدول الموجود فعلياً في Nile
}

model PurchaseItem {
  id          String   @id @default(uuid())
  purchase_id String
  purchase    Purchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  product_id  String
  quantity    Int
  unit_price  Decimal  @db.Decimal(10, 2)

  @@index([purchase_id])
  @@map("purchase_item") // يربط الموديل بالجدول الموجود فعلياً
}
