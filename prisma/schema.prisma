model Purchase {
  id              String   @id @default(uuid())
  tenant_id       String
  idempotency_key String   @unique // <--- مهم جداً ليعمل كود الـ API الخاص بك
  total_amount    Float
  status          String
  items           Item[]
  createdAt       DateTime @default(now())
}

model Item {
  id          String   @id @default(uuid())
  product_id  String
  quantity    Int
  unit_price  Float
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id])
}
