// ملف schema.prisma الكامل

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

model Purchase {
  id              String         @id @default(uuid())
  tenant_id       String
  idempotency_key String
  total_amount    Decimal        @db.Decimal(10, 2)
  status          String
  created_at      DateTime       @default(now())
  items           PurchaseItem[]

  // المفتاح الفريد المركب يضمن عدم تكرار الـ idempotency_key لنفس المستأجر
  @@unique([tenant_id, idempotency_key])
  @@index([tenant_id])
  @@map("purchase")
  @@schema("public")
}

model PurchaseItem {
  id          String   @id @default(uuid())
  purchase_id String
  purchase    Purchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  product_id  String
  quantity    Int
  unit_price  Decimal  @db.Decimal(10, 2)

  @@index([purchase_id])
  @@map("purchase_item")
  @@schema("public")
}
