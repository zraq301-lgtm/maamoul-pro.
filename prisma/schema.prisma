model Purchase {
  id              String         @id @default(uuid())
  tenant_id       String
  idempotency_key String         @unique // هام جداً: هذا يمنع التكرار على مستوى قاعدة البيانات
  total_amount    Decimal
  status          String
  created_at      DateTime       @default(now())
  items           PurchaseItem[] // علاقة مع جدول العناصر

  @@index([tenant_id])
}

model PurchaseItem {
  id          String   @id @default(uuid())
  purchase_id String
  purchase    Purchase @relation(fields: [purchase_id], references: [id])
  product_id  String
  quantity    Int
  unit_price  Decimal
}
