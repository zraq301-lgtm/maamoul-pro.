// 1. تعريف المولد
generator client {
  provider = "prisma-client-js"
}

// 2. تعريف مصدر البيانات (يعتمد على متغير البيئة DATABASE_URL الممرر من Vercel)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 3. النماذج (الجداول)
model Purchase {
  id              String         @id @default(uuid())
  tenant_id       String
  idempotency_key String         @unique
  total_amount    Decimal
  status          String
  created_at      DateTime       @default(now())
  items           PurchaseItem[]
}

model PurchaseItem {
  id          String   @id @default(uuid())
  purchase_id String
  purchase    Purchase @relation(fields: [purchase_id], references: [id])
  product_id  String
  quantity    Int
  unit_price  Decimal
}
